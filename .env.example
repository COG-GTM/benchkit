# MongoDB Configuration
# For local development
MONGODB_URI=mongodb://localhost:27017/benchkit

# For production with Cosmos DB
# MONGODB_URI=mongodb://your-cosmos-account.mongo.cosmos.azure.com:10255/benchkit?ssl=true&replicaSet=globaldb&retrywrites=false&maxIdleTimeMS=120000&appName=@your-cosmos-account@

# Authentication (all /api/** routes require a signed-in user)
# Behind Azure App Service Authentication (Easy Auth): trust its principal header,
# matched against User.azureId. Never enable when the app is reachable directly.
# NUXT_AUTH_TRUST_EASY_AUTH=true
# Local `pnpm dev` only: sign every request in as this user (created as admin if missing)
NUXT_AUTH_DEV_USER_EMAIL=admin@example.com

# Azure Configuration
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id

# File Storage Configuration
STORAGE_ACCOUNT_NAME=your-storage-account
STORAGE_ACCOUNT_KEY=your-storage-key
STORAGE_CONTAINER_NAME=benchkit-files
